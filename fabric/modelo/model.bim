        ],
        "partitions": [
          {
            "name": "FactCompras",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fact_compras",
              "schemaName": "gold",
              "expressionSource": "DatabaseQuery"
            }
          }
        ],
        "measures": [
          {
            "name": "Coste total de compras",
            "expression": [
              "CALCULATE (",
              "    SUM ( FactCompras[importe] ),",
              "    NOT FactCompras[estado_pedido] IN { \"borrador\", \"cancelado\" }",
              ")"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Compras",
            "description": "Importe pedido (cantidad × precio) de pedidos no cancelados ni en borrador."
          },
          {
            "name": "Pedidos",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( FactCompras[pedido_id] ),",
              "    NOT FactCompras[estado_pedido] IN { \"borrador\", \"cancelado\" }",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Compras",
            "description": "Número de pedidos distintos (no líneas)."
          },
          {
            "name": "Importe medio por pedido",
            "expression": [
              "DIVIDE ( [Coste total de compras], [Pedidos] )"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Compras",
            "description": "Coste total dividido entre pedidos."
          },
          {
            "name": "Precio medio de compra",
            "expression": [
              "CALCULATE (",
              "    DIVIDE ( SUM ( FactCompras[importe] ), SUM ( FactCompras[cantidad_pedida] ) ),",
              "    NOT FactCompras[estado_pedido] IN { \"borrador\", \"cancelado\" }",
              ")"
            ],
            "formatString": "#,0.0000 €",
            "displayFolder": "Compras",
            "description": "Precio medio ponderado por cantidad. Solo tiene sentido filtrado por producto."
          },
          {
            "name": "Desviación sobre coste estándar %",
            "expression": [
              "VAR Real = [Coste total de compras]",
              "VAR AEstandar =",
              "    CALCULATE (",
              "        SUMX ( FactCompras, FactCompras[cantidad_pedida] * RELATED ( DimProducto[coste_estandar] ) ),",
              "        NOT FactCompras[estado_pedido] IN { \"borrador\", \"cancelado\" }",
              "    )",
              "RETURN",
              "    DIVIDE ( Real - AEstandar, AEstandar )"
            ],
            "formatString": "0.0 %",
            "displayFolder": "Compras",
            "description": "Cuánto se ha pagado por encima (+) o por debajo (−) del coste estándar, ponderado por cantidad comprada."
          },
          {
            "name": "Gasto mes anterior",
            "expression": [
              "CALCULATE ( [Coste total de compras], DATEADD ( DimFecha[fecha], -1, MONTH ) )"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Evolución",
            "description": "Coste total de compras del mes anterior al periodo visible."
          },
          {
            "name": "Variación mensual del gasto %",
            "expression": [
              "VAR Anterior = [Gasto mes anterior]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( Anterior ) && NOT ISBLANK ( [Coste total de compras] ),",
              "        DIVIDE ( [Coste total de compras] - Anterior, Anterior )",
              "    )"
            ],
            "formatString": "0.0 %",
            "displayFolder": "Evolución",
            "description": "Cambio respecto al mes anterior."
          },
          {
            "name": "Gasto acumulado del año",
            "expression": [
              "TOTALYTD ( [Coste total de compras], DimFecha[fecha] )"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Evolución",
            "description": "Acumulado desde el 1 de enero hasta el final del periodo visible."
          },
          {
            "name": "Gasto media móvil 3 meses",
            "expression": [
              "VAR Ventana = DATESINPERIOD ( DimFecha[fecha], MAX ( DimFecha[fecha] ), -3, MONTH )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( [Coste total de compras] ),",
              "        AVERAGEX (",
              "            CALCULATETABLE ( VALUES ( DimFecha[anio_mes] ), Ventana ),",
              "            CALCULATE ( [Coste total de compras], ALLEXCEPT ( DimFecha, DimFecha[anio_mes] ) )",
              "        )",
              "    )"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Evolución",
            "description": "Media mensual de los tres últimos meses terminados en el periodo visible."
          },
          {
            "name": "Pedidos completados",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( FactCompras[pedido_id] ), FactCompras[pedido_completo] = TRUE () )"
            ],
            "formatString": "#,0",
            "displayFolder": "Proveedores",
            "description": "Pedidos recibidos por completo."
          },
          {
            "name": "Pedidos a tiempo",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( FactCompras[pedido_id] ),",
              "    FactCompras[pedido_completo] = TRUE (),",
              "    FactCompras[pedido_a_tiempo] = TRUE ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Proveedores",
            "description": "Pedidos completos cuya última recepción llegó en la fecha prevista o antes."
          },
          {
            "name": "% Entregas puntuales",
            "expression": [
              "DIVIDE ( [Pedidos a tiempo], [Pedidos completados] )"
            ],
            "formatString": "0.0 %",
            "displayFolder": "Proveedores",
            "description": "Pedidos a tiempo sobre pedidos completados."
          },
          {
            "name": "Retraso medio (días)",
            "expression": [
              "AVERAGEX (",
              "    CALCULATETABLE (",
              "        SUMMARIZE ( FactCompras, FactCompras[pedido_id], FactCompras[dias_retraso] ),",
              "        FactCompras[pedido_completo] = TRUE ()",
              "    ),",
              "    FactCompras[dias_retraso]",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Proveedores",
            "description": "Media de días de retraso por pedido completado (0 si llegó a tiempo). Se reduce a un pedido por fila antes de promediar."
          },
          {
            "name": "Plazo real medio (días)",
            "expression": [
              "AVERAGEX (",
              "    CALCULATETABLE (",
              "        SUMMARIZE ( FactCompras, FactCompras[pedido_id], FactCompras[plazo_real_dias] ),",
              "        FactCompras[pedido_completo] = TRUE ()",
              "    ),",
              "    FactCompras[plazo_real_dias]",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Proveedores",
            "description": "Días entre el pedido y su última recepción, por pedido completado."
          },
          {
            "name": "Desviación de plazo (días)",
            "expression": [
              "IF (",
              "    HASONEVALUE ( DimProveedor[proveedor_key] ) && NOT ISBLANK ( [Plazo real medio (días)] ),",
              "    [Plazo real medio (días)] - SELECTEDVALUE ( DimProveedor[plazo_acordado_dias] )",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Proveedores",
            "description": "Plazo real medio menos plazo acordado del proveedor."
          },
          {
            "name": "Cuota de gasto %",
            "expression": [
              "DIVIDE ( [Coste total de compras], CALCULATE ( [Coste total de compras], REMOVEFILTERS ( DimProveedor ) ) )"
            ],
            "formatString": "0.0 %",
            "displayFolder": "Proveedores",
            "description": "Peso del proveedor sobre el gasto total del periodo."
          },
          {
            "name": "Ranking de proveedor por gasto",
            "expression": [
              "IF (",
              "    HASONEVALUE ( DimProveedor[proveedor_key] ) && NOT ISBLANK ( [Coste total de compras] ),",
              "    -- ALLSELECTED sobre la TABLA: si solo se liberase la clave, el filtro de la columna visible (código o nombre)",
              "    -- seguiría activo y todos los proveedores quedarían primeros.",
              "    RANKX ( ALLSELECTED ( DimProveedor ), [Coste total de compras],, DESC, DENSE )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Proveedores",
            "description": "Posición del proveedor por gasto en el periodo."
          }
        ]
      },
      {
        "name": "FactRecepciones",
        "columns": [
          {
            "name": "linea_recepcion_id",
