            "dataType": "int64",
            "sourceColumn": "fecha_ultima_recepcion_pedido_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "pedido_completo",
            "dataType": "boolean",
            "sourceColumn": "pedido_completo",
            "summarizeBy": "none"
          },
          {
            "name": "pedido_a_tiempo",
            "dataType": "boolean",
            "sourceColumn": "pedido_a_tiempo",
            "summarizeBy": "none"
          },
          {
            "name": "dias_retraso",
            "dataType": "int64",
            "sourceColumn": "dias_retraso",
            "summarizeBy": "none"
          },
