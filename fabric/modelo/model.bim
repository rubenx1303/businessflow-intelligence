            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "proveedor_key",
            "dataType": "int64",
            "sourceColumn": "proveedor_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "almacen_key",
            "dataType": "int64",
            "sourceColumn": "almacen_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "cantidad_recibida",
            "dataType": "decimal",
            "sourceColumn": "cantidad_recibida",
            "summarizeBy": "none"
          },
          {
            "name": "cantidad_rechazada",
            "dataType": "decimal",
            "sourceColumn": "cantidad_rechazada",
            "summarizeBy": "none"
          },
          {
            "name": "importe_recibido",
            "dataType": "decimal",
            "sourceColumn": "importe_recibido",
            "summarizeBy": "none"
          },
          {
            "name": "dias_desde_pedido",
            "dataType": "int64",
            "sourceColumn": "dias_desde_pedido",
            "summarizeBy": "none"
          },
          {
            "name": "dias_respecto_previsto",
            "dataType": "int64",
            "sourceColumn": "dias_respecto_previsto",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "FactRecepciones",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fact_recepciones",
              "schemaName": "gold",
              "expressionSource": "DatabaseQuery"
            }
          }
        ],
        "measures": [
          {
            "name": "% Rechazo",
            "expression": [
              "DIVIDE (",
              "    SUM ( FactRecepciones[cantidad_rechazada] ),",
              "    SUM ( FactRecepciones[cantidad_recibida] ) + SUM ( FactRecepciones[cantidad_rechazada] )",
              ")"
            ],
            "formatString": "0.00 %",
            "displayFolder": "Proveedores",
            "description": "Unidades rechazadas sobre el total entregado (aceptado + rechazado)."
          },
          {
            "name": "Importe recibido",
            "expression": [
              "SUM ( FactRecepciones[importe_recibido] )"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Proveedores",
            "description": "Valor de la mercancía aceptada, a precio de compra."
          }
        ]
      },
      {
        "name": "FactMovimientosInventario",
        "columns": [
          {
            "name": "movimiento_id",
            "dataType": "int64",
            "sourceColumn": "movimiento_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha_key",
            "dataType": "int64",
            "sourceColumn": "fecha_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "producto_key",
            "dataType": "int64",
            "sourceColumn": "producto_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "almacen_key",
            "dataType": "int64",
            "sourceColumn": "almacen_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "tipo_movimiento",
            "dataType": "string",
            "sourceColumn": "tipo_movimiento",
            "summarizeBy": "none"
          },
          {
            "name": "recepcion_id",
            "dataType": "int64",
            "sourceColumn": "recepcion_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "cantidad",
            "dataType": "decimal",
            "sourceColumn": "cantidad",
            "summarizeBy": "none"
          },
          {
            "name": "coste_unitario",
            "dataType": "decimal",
            "sourceColumn": "coste_unitario",
            "summarizeBy": "none"
          },
          {
            "name": "importe",
            "dataType": "decimal",
            "sourceColumn": "importe",
            "summarizeBy": "none"
          },
          {
            "name": "cantidad_entrada",
            "dataType": "decimal",
            "sourceColumn": "cantidad_entrada",
            "summarizeBy": "none"
          },
          {
            "name": "cantidad_salida",
            "dataType": "decimal",
            "sourceColumn": "cantidad_salida",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "FactMovimientosInventario",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fact_movimientos_inventario",
              "schemaName": "gold",
              "expressionSource": "DatabaseQuery"
            }
          }
        ],
        "measures": [
          {
            "name": "Stock",
            "expression": [
              "VAR UltimaFecha = MAX ( DimFecha[fecha] )",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( FactMovimientosInventario[cantidad] ),",
              "        REMOVEFILTERS ( DimFecha ),",
              "        DimFecha[fecha] <= UltimaFecha",
              "    )"
            ],
            "formatString": "#,0.###",
            "displayFolder": "Inventario",
            "description": "Existencias al cierre de la última fecha visible: suma acumulada de todos los movimientos hasta esa fecha."
          },
          {
            "name": "Valor del inventario",
            "expression": [
              "SUMX ( DimProducto, [Stock] * DimProducto[coste_estandar] )"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Inventario",
            "description": "Stock de cada producto valorado a su coste estándar. Semiaditivo: no se suma entre fechas."
          },
          {
            "name": "Productos bajo mínimo",
            "expression": [
              "COUNTROWS (",
              "    FILTER ( DimProducto, DimProducto[activo] = TRUE () && [Stock] < DimProducto[stock_minimo] )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Inventario",
            "description": "Productos activos cuyo stock total está por debajo de su stock mínimo."
          },
          {
            "name": "Entradas (unidades)",
            "expression": [
              "SUM ( FactMovimientosInventario[cantidad_entrada] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Inventario",
            "description": "Unidades que han entrado en el periodo."
          },
          {
            "name": "Consumo (unidades)",
            "expression": [
              "CALCULATE (",
              "    SUM ( FactMovimientosInventario[cantidad_salida] ),",
              "    FactMovimientosInventario[tipo_movimiento] = \"SALIDA_CONSUMO\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Consumo",
            "description": "Unidades salidas por consumo en el periodo."
          },
          {
            "name": "Consumo valorado",
            "expression": [
              "CALCULATE (",
              "    - SUM ( FactMovimientosInventario[importe] ),",
              "    FactMovimientosInventario[tipo_movimiento] = \"SALIDA_CONSUMO\"",
              ")"
            ],
            "formatString": "#,0.00 €",
            "displayFolder": "Consumo",
            "description": "Coste de lo consumido en el periodo. Con la dimensión de producto da el consumo por categoría."
          },
          {
            "name": "Cuota de consumo por categoría %",
            "expression": [
              "DIVIDE ( [Consumo valorado], CALCULATE ( [Consumo valorado], REMOVEFILTERS ( DimProducto ) ) )"
            ],
            "formatString": "0.0 %",
            "displayFolder": "Consumo",
            "description": "Peso de la selección sobre el consumo valorado total."
          },
          {
            "name": "Días del periodo",
            "expression": [
              "VAR Primera = CALCULATE ( MIN ( DimFecha[fecha] ), FactMovimientosInventario )",
              "VAR Ultima = CALCULATE ( MAX ( DimFecha[fecha] ), FactMovimientosInventario )",
              "RETURN",
              "    IF ( NOT ISBLANK ( Primera ), DATEDIFF ( Primera, Ultima, DAY ) + 1 )"
            ],
            "formatString": "#,0",
            "displayFolder": "Inventario",
            "description": "Días entre el primer y el último movimiento del periodo visible."
          },
          {
            "name": "Rotación de inventario",
            "expression": [
              "DIVIDE ( DIVIDE ( [Consumo valorado] * 365, [Días del periodo] ), [Valor del inventario] )"
            ],
            "formatString": "#,0.0 x",
            "displayFolder": "Inventario",
            "description": "Veces al año que se renueva el inventario: consumo valorado anualizado entre el valor del inventario al cierre."
          },
          {
            "name": "Consumo medio diario (90 días)",
            "expression": [
              "VAR Ultima = CALCULATE ( MAX ( DimFecha[fecha] ), FactMovimientosInventario )",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( [Consumo (unidades)], DATESINPERIOD ( DimFecha[fecha], Ultima, -90, DAY ) ),",
              "        90",
              "    )"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Inventario",
            "description": "Unidades consumidas al día en los 90 días anteriores al último movimiento visible."
          },
          {
            "name": "Días de cobertura",
            "expression": [
              "DIVIDE ( [Stock], [Consumo medio diario (90 días)] )"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Inventario",
            "description": "Cuántos días dura el stock actual al ritmo de consumo de los últimos 90 días."
          }
        ]
      }
    ],
