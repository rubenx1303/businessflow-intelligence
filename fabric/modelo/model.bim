            "sourceColumn": "cantidad_pedida",
            "summarizeBy": "none"
          },
          {
            "name": "precio_unitario",
            "dataType": "decimal",
            "sourceColumn": "precio_unitario",
            "summarizeBy": "none"
          },
          {
            "name": "importe",
            "dataType": "decimal",
            "sourceColumn": "importe",
            "summarizeBy": "none"
          },
          {
            "name": "cantidad_recibida",
            "dataType": "decimal",
            "sourceColumn": "cantidad_recibida",
            "summarizeBy": "none"
          },
          {
            "name": "cantidad_rechazada",
            "dataType": "decimal",
            "sourceColumn": "cantidad_rechazada",
            "summarizeBy": "none"
          },
